# development / testing / production
APP_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# 轮换窗口内保留旧密钥；所有旧会话过期后清空。
SESSION_SECRET_PREVIOUS=
MFA_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
# 轮换 MFA 加密密钥时临时保留上一把密钥，避免已启用用户被锁死。
MFA_ENCRYPTION_KEY_PREVIOUS=
# 生产必填：接收原始文件并返回 {"clean": true} 的企业恶意文件扫描网关。
ATTACHMENT_SCANNER_URL=https://replace-with-your-scanner.example/scan
ATTACHMENT_ENCRYPTION_KEY=replace-with-an-independent-secret-at-least-32-characters
ATTACHMENT_ENCRYPTION_KEY_PREVIOUS=
ATTACHMENT_RETENTION_DAYS=365
CUSTOMER_RETENTION_DAYS=730
SYNC_FAILURE_RETENTION_DAYS=30
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SIGNING_KEY=
AUDIT_SIGNING_KEY=replace-with-a-third-independent-random-secret-at-least-32-characters
AUDIT_CHECKPOINT_PATH=./audit-checkpoints/checkpoints.jsonl
PRIVACY_HASH_KEY=replace-with-a-fourth-independent-random-secret-at-least-32-characters
HEALTH_TOKEN=replace-with-a-random-health-token
DISPLAY_TIMEZONE=Asia/Shanghai
BUSINESS_TIMEZONE=America/Los_Angeles
# 仅列出实际终止 TLS 且重写来源地址的反向代理 IP，逗号分隔。
TRUSTED_PROXY_IPS=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# 生产默认禁止 Demo AI；仅离线演练时才显式设为 true。
ALLOW_DEMO_AI=true
SYNC_INLINE=true
MIGRATE_ON_STARTUP=true
# demo 读取 samples；http 从已授权的企业 SP-API 网关读取标准化 rows。
CHANNEL_ADAPTER=demo
AMAZON_ADAPTER_BASE_URL=
AMAZON_ADAPTER_TOKEN=
AMAZON_ADAPTER_TIMEOUT_SECONDS=30
JOB_STALE_SECONDS=120
WORKER_HEALTH_SECONDS=30
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
# 按所用模型合同填写；0 表示只统计 Token、不估算成本。
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
DATABASE_PATH=data/app.db
MEDIA_ROOT=data/media
PRIVATE_ROOT=data/private
BACKUP_ROOT=backups
BACKUP_MAX_AGE_HOURS=26
BACKUP_REPLICA_PATH=./backups/replica
BACKUP_REPLICA_HOST_PATH=../cross-border-ai-backup-replica
AUDIT_CHECKPOINT_HOST_PATH=../cross-border-ai-audit-checkpoints
APPROVER_LIMIT_USD=500
MAX_REQUEST_BYTES=12582912
# SQLite 生产部署固定为单 Web 进程；需要扩容时先迁移 PostgreSQL。
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
